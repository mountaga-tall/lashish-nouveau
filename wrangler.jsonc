{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "menushish",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "menushish-db",
      "database_id": "8d71abf1-1797-4cb1-b500-46b2c2ea479b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "menushish-images"
    }
  ],
  "routes": [
    {
      "pattern": "menushish.ci",
      "custom_domain": true
    },
    {
      "pattern": "www.menushish.ci",
      "custom_domain": true
    }
  ]
}
