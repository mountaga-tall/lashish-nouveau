# Prevent stale HTML, JavaScript and service worker versions after a deployment.
/
  Cache-Control: no-store, max-age=0

/*.html
  Cache-Control: no-store, max-age=0

/app.js
  Cache-Control: no-cache, no-store, must-revalidate

/style.css
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
